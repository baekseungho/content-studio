# .env로 복사하고 값을 채운 뒤 앱을 다시 실행하세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# 밝은 후기의 문장만 다듬는 단계. 사진은 다시 보내지 않습니다.
OPENAI_WRITING_MODEL=gpt-5.4
# 장소 후보 찾기만 경량 모델로 사용. 주소 확인과 글의 상세정보 조사는 별도로 유지합니다.
OPENAI_PLACE_MODEL=gpt-5.4-nano
PORT=8787
# Business / Creator 계정. 통합 로그인=unified, Instagram Login=instagram
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v27.0
# 끝에 /media를 붙이지 마세요. 외부에서 /media/<id>-ig.jpg에 접근 가능해야 해요.
PUBLIC_MEDIA_BASE_URL=
# blog.naver.com/ 뒤에 오는 아이디
NAVER_BLOG_ID=

# auto로 구분되지 않는 토큰이면 발급한 방식(unified / instagram)을 직접 지정하세요.
INSTAGRAM_LOGIN_TYPE=auto

# Threads 전용 계정과 사용자 토큰. Instagram 토큰과 별개입니다.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_API_VERSION=v1.0

# 선택: 네이버 지역 검색으로 장소 후보를 찾을 때 사용 (블로그 발행 권한과 별개).
# 비워 두면 기존 OpenAI 웹 검색으로 후보를 찾습니다. 이름·주소 직접 입력도 가능합니다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# Naver Cloud API HUB=ncp, 기존 Naver Developers 검색 API=naver
NAVER_SEARCH_PROVIDER=ncp
