# .env로 복사하고 값을 채운 뒤 앱을 다시 실행하세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# 밝은 후기의 문장만 다듬는 단계. 사진은 다시 보내지 않습니다.
OPENAI_WRITING_MODEL=gpt-5.4
PORT=8787
# Business / Creator 계정. 통합 로그인=unified, Instagram Login=instagram
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v27.0
# 끝에 /media를 붙이지 마세요. 외부에서 /media/<id>-ig.jpg에 접근 가능해야 해요.
PUBLIC_MEDIA_BASE_URL=
# blog.naver.com/ 뒤에 오는 아이디
NAVER_BLOG_ID=

INSTAGRAM_LOGIN_TYPE=auto
