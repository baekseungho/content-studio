{
  "manifest_version": 3,
  "name": "Mellow Studio · 블로그 글쓰기 도우미",
  "version": "1.5.3",
  "description": "로그인된 네이버·티스토리 편집기에 글과 사진을 옮깁니다. 최종 발행은 직접 진행합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://blog.naver.com/*",
    "https://*.tistory.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mellow Studio",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "minimum_chrome_version": "102",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
