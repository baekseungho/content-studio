{
  "manifest_version": 3,
  "name": "다정 스튜디오 · 네이버 글쓰기 도우미",
  "version": "1.4.1",
  "description": "로그인된 네이버 글쓰기 탭에 사용자가 선택한 초안과 사진을 입력합니다. 최종 발행은 직접 진행합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://blog.naver.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "다정 스튜디오"
  },
  "minimum_chrome_version": "102",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  }
}
